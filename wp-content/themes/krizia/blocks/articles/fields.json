        "conditional_logic": [
          [
            {
              "field": "field_articles_mode",
              "operator": "==",
              "value": "latest"
            }
          ]
        ]
      },
      {
        "key": "field_articles_manual_posts",
        "label": "Articles à afficher",
        "name": "articles_manual_posts",
        "type": "relationship",
        "post_type": [
          "post"
        ],
        "filters": [
          "search",
          "taxonomy"
        ],
        "return_format": "object",
        "conditional_logic": [
          [
            {
              "field": "field_articles_mode",
              "operator": "==",
              "value": "manual"
            }
          ]
        ]
      }
    ],
    "location": [
